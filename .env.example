# ─────────────────────────────────────────────────────────────────────────────
# GeekCommerze — Environment Keys Reference
#
# This file is committed to git and documents every key the app needs.
# ⚠️  Do NOT put real keys here.
#
# HOW TO CONFIGURE THE APP:
#   1. Open geekcommerze/geekcommerze/AppConfig.swift
#   2. Replace each "YOUR_..." placeholder with the real value from below
#   3. Run: git update-index --assume-unchanged geekcommerze/geekcommerze/AppConfig.swift
#      (so git stops tracking your local edits to that file)
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ──────────────────────────────────────────────────────────────────
# Source: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...


# ── Stripe ────────────────────────────────────────────────────────────────────
# Source: Stripe Dashboard → Developers → API Keys
# Use pk_test_... during development, pk_live_... for production

STRIPE_PUBLISHABLE_KEY=pk_test_...


# ── Push Notifications (OneSignal) ────────────────────────────────────────────
# Source: OneSignal Dashboard → Settings → Keys & IDs

ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ── Crash Reporting (Sentry) ──────────────────────────────────────────────────
# Source: Sentry Dashboard → Project Settings → Client Keys (DSN)

SENTRY_DSN=https://xxxx@oXXX.ingest.sentry.io/XXXX


# ── App URLs ──────────────────────────────────────────────────────────────────
# Update in AppConfig.URLs before App Store submission

APP_PRIVACY_URL=https://yourdomain.com/privacy
APP_TERMS_URL=https://yourdomain.com/terms
APP_SUPPORT_URL=https://yourdomain.com/support
